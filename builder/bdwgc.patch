+GC_INNER void
+GC_flush_object_counts(void)
+{
+  AO_t allocated = AO_load(&GC_objects_allocd_tmp);
+  AO_t freed = AO_load(&GC_objects_freed_tmp);
+
+  GC_ASSERT(I_HOLD_LOCK());
+  if (allocated != 0) {
+    (void)AO_fetch_and_add(&GC_objects_allocd_tmp, (AO_t)(-allocated));
+    GC_objects_allocd += allocated;
+  }
+  if (freed != 0) {
+    (void)AO_fetch_and_add(&GC_objects_freed_tmp, (AO_t)(-freed));
+    GC_objects_freed += freed;
+  }
+}
 #endif
 
+GC_INNER void
+GC_record_allocation_list(void *p)
+{
+  struct hblk *block = NULL;
+  hdr *hhdr = NULL;
+  word masks[MARK_BITS_PER_HBLK / CPP_WORDSZ] = { 0 };
+  size_t i;
+
+  for (;;) {
+    struct hblk *next_block = p != NULL ? HBLKPTR(p) : NULL;
+    if (next_block != block || p == NULL) {
+      if (hhdr != NULL) {
+        for (i = 0; i < MARK_BITS_PER_HBLK / CPP_WORDSZ; i++) {
+#ifdef PARALLEL_MARK
+          if (masks[i] != 0)
+            AO_or((volatile AO_t *)&hhdr->hb_alloc_bits[i], masks[i]);
+#else
+          hhdr->hb_alloc_bits[i] |= masks[i];
+#endif
+          masks[i] = 0;
+        }
+      }
+      if (next_block == NULL)
+        break;
+      block = next_block;
+      hhdr = HDR(block);
+    }
+    {
+      size_t bit_no = MARK_BIT_NO(HBLKDISPL(p), hhdr->hb_sz);
+      masks[divWORDSZ(bit_no)] |= (word)1 << modWORDSZ(bit_no);
+    }
+    p = obj_link(p);
+  }
+}
+
+GC_INNER void
+GC_record_released_object(void *p)
+{
+  hdr *hhdr = HDR(p);
+  size_t bit_no = MARK_BIT_NO(HBLKDISPL(p), hhdr->hb_sz);
+  word mask = (word)1 << modWORDSZ(bit_no);
+  word old_bits;
+#ifdef PARALLEL_MARK
+  volatile AO_t *bits
+      = (volatile AO_t *)&hhdr->hb_alloc_bits[divWORDSZ(bit_no)];
+  do {
+    old_bits = AO_load(bits);
+  } while (!AO_compare_and_swap_release(bits, old_bits, old_bits & ~mask));
+#else
+  word *bits = &hhdr->hb_alloc_bits[divWORDSZ(bit_no)];
+  old_bits = *bits;
+  *bits &= ~mask;
+#endif
+  if ((old_bits & mask) != 0)
+    GC_objects_freed++;
+}
+
+GC_INNER void
+GC_record_reclaimed_objects(hdr *hhdr, size_t sz)
+{
+  word reclaimed = 0;
+  size_t i;
+
+  for (i = 0; i < MARK_BITS_PER_HBLK / CPP_WORDSZ; i++) {
+    word marked = 0;
+    word old_bits, dead;
+#ifdef USE_MARK_BYTES
+    size_t j;
+    for (j = 0; j < CPP_WORDSZ; j++)
+      if (hhdr->hb_marks[i * CPP_WORDSZ + j])
+        marked |= (word)1 << j;
+#else
+    marked = hhdr->hb_marks[i];
+#endif
+    if (sz > MAXOBJBYTES)
+      marked = i == 0 ? (word)(mark_bit_from_hdr(hhdr, 0) != 0) : 0;
+#ifdef PARALLEL_MARK
+    {
+      volatile AO_t *bits = (volatile AO_t *)&hhdr->hb_alloc_bits[i];
+      do {
+        old_bits = AO_load(bits);
+      } while (
+          !AO_compare_and_swap_release(bits, old_bits, old_bits & marked));
+    }
+#else
+    old_bits = hhdr->hb_alloc_bits[i];
+    hhdr->hb_alloc_bits[i] = old_bits & marked;
+#endif
+    dead = old_bits & ~marked;
+    while (dead != 0) {
+      dead &= dead - 1;
+      reclaimed++;
+    }
+  }
+#ifdef PARALLEL_MARK
+  if (reclaimed != 0)
+    (void)AO_fetch_and_add(&GC_objects_freed_tmp, reclaimed);
+#else
+  GC_objects_freed += reclaimed;
+#endif
+}
